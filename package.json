{
  "name": "console-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "server": "tsx server/index.ts",
    "collaboration": "tsx server/collaboration/server.ts",
    "test": "tsx --test server/collaboration/*.test.ts",
    "signaling": "node node_modules/y-webrtc/bin/server.js",
    "dev:all": "concurrently \"vite\" \"tsx server/index.ts\" \"tsx server/collaboration/server.ts\""
  },
  "dependencies": {
    "@hocuspocus/extension-database": "^3.4.4",
    "@hocuspocus/provider": "^3.4.4",
    "@hocuspocus/server": "^3.4.4",
    "express": "^5.1.0",
    "firebase": "^11.10.0",
    "firebase-admin": "^13.10.0",
    "monaco-editor": "^0.52.2",
    "pg": "^8.16.3",
    "ws": "^8.22.2",
    "y-indexeddb": "^9.0.12",
    "y-monaco": "^0.1.6",
    "y-protocols": "^1.0.7",
    "y-webrtc": "^10.3.0",
    "yjs": "^13.6.20"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^22.15.30",
    "@types/pg": "^8.15.5",
    "@types/ws": "^8.18.2",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
